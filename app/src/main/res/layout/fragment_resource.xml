<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="false">

    <!-- Back Arrow Button with proper insets - positioned relative to system bars -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/backButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:src="@drawable/ic_arrow_back"
        android:contentDescription="@string/navigate_back"
        app:fabSize="mini"
        app:backgroundTint="@color/back_button_background"
        app:tint="@android:color/white"
        app:elevation="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="visible"
        android:indeterminate="true"
        app:indicatorColor="?attr/colorPrimary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/retryLayout"
        layout="@layout/layout_retry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:fitsSystemWindows="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Edge-to-edge WebView that draws behind system bars -->
        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fitsSystemWindows="false"
            android:scrollbarStyle="outsideOverlay"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- System UI Protection Gradient (Top) - Provides contrast for status bar area -->
        <View
            android:id="@+id/topSystemBarProtection"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@drawable/gradient_top_protection"
            android:fitsSystemWindows="false"
            android:visibility="visible"
            android:elevation="1dp"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- System UI Protection Gradient (Bottom) - Provides contrast for navigation bar area -->
        <View
            android:id="@+id/bottomSystemBarProtection"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@drawable/gradient_bottom_protection"
            android:fitsSystemWindows="false"
            android:visibility="visible"
            android:elevation="1dp"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Fullscreen Toggle Button - positioned relative to navigation bar -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fullscreenToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:contentDescription="@string/toggle_fullscreen_mode"
            android:src="@drawable/ic_fullscreen"
            app:fabSize="mini"
            app:backgroundTint="?attr/colorSurfaceContainer"
            app:tint="?attr/colorOnSurfaceVariant"
            app:elevation="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Reuse Template Button - positioned relative to navigation bar -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/reuseTemplateButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:contentDescription="@string/reuse_template_description"
            android:src="@drawable/ic_refresh"
            app:backgroundTint="?attr/colorPrimary"
            app:tint="?attr/colorOnPrimary"
            app:elevation="6dp"
            app:layout_constraintBottom_toTopOf="@id/fullscreenToggle"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>