<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:animateLayoutChanges="false">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardView"
        style="@style/Widget.EventWish.Card.Festive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        app:rippleColor="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardCornerRadius="12dp"
        app:cardElevation="1dp"
        app:strokeWidth="0.5dp"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="3dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="@color/card_festive_light">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Instagram-style Header with Profile -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <!-- Profile Picture -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/profileImage"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/app_logo"
                    android:contentDescription="Profile picture"
                    app:shapeAppearanceOverlay="@style/CircleImageView"
                    android:scaleType="centerCrop" />

                <!-- Profile Info -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <!-- Username and Category -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="eventwish"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface" />

                        <View
                            android:layout_width="4dp"
                            android:layout_height="4dp"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/circle_dot"
                            android:backgroundTint="?attr/colorOnSurfaceVariant" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/categoryIcon"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="gone"
                            android:src="@drawable/ic_category"
                            android:contentDescription="Category icon"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/categoryText"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="gone"
                            android:textSize="14sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:layout_marginStart="4dp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            tools:text="Birthday" />
                    </LinearLayout>

                    <!-- Time Display -->
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/timeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginTop="2dp"
                        android:visibility="visible"
                        tools:text="2 hours ago" />
                </LinearLayout>

                <!-- More Options Button -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/moreOptionsIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_more_vert"
                    android:contentDescription="More options"
                    android:padding="2dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <!-- Template Title - Moved ABOVE the image -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/titleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.EventWish.Body"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:lineSpacingExtra="2dp"
                    tools:text="Beautiful birthday template for celebrating special moments with friends and family. Perfect for social media posts and greetings." />
            </LinearLayout>

            <!-- Main Content Area - Supports HTML, Image, and Video -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Image Template Display -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/template_image"
                    android:layout_width="match_parent"
                    android:layout_height="480dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/template_image_description"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:visibility="visible"
                    tools:src="@drawable/placeholder_image" />

                <!-- HTML Template Display -->
                <LinearLayout
                    android:id="@+id/html_template_container"
                    android:layout_width="match_parent"
                    android:layout_height="480dp"
                    android:orientation="vertical"
                    android:background="@color/html_preview_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:visibility="gone"
                    android:padding="8dp">
                    
                    <!-- HTML Preview WebView -->
                    <WebView
                        android:id="@+id/html_preview_webview"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@android:color/white"
                        android:layout_marginBottom="8dp" />
                    
                    <!-- HTML Template Info (compact version below WebView) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        
                        <!-- HTML Template Title -->
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/html_template_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.EventWish.Body2"
                            android:textColor="?attr/colorOnSurface"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:layout_marginEnd="8dp"
                            tools:text="Interactive Birthday Card" />
                        
                        <!-- HTML Template Features (compact chips) -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            android:orientation="horizontal">
                            
                            <com.google.android.material.chip.Chip
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Interactive"
                                android:textSize="10sp"
                                style="@style/Widget.EventWish.Chip"
                                android:layout_marginEnd="4dp" />
                            
                            <com.google.android.material.chip.Chip
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="HTML"
                                android:textSize="10sp"
                                style="@style/Widget.EventWish.Chip" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Video Template Display -->
                <LinearLayout
                    android:id="@+id/video_template_container"
                    android:layout_width="match_parent"
                    android:layout_height="480dp"
                    android:orientation="vertical"
                    android:background="@color/video_preview_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:visibility="gone"
                    android:gravity="center">
                    
                    <!-- Video Player Container -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@android:color/black">
                        
                        <!-- ExoPlayer PlayerView for actual video playback -->
                        <androidx.media3.ui.PlayerView
                            android:id="@+id/video_player_view"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone"
                            app:use_controller="false"
                            app:resize_mode="zoom"
                            app:surface_type="texture_view" />
                        
                        <!-- Video Thumbnail (shown when video is not playing) -->
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/video_thumbnail"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:contentDescription="Video thumbnail"
                            android:visibility="visible"
                            tools:src="@drawable/placeholder_image" />
                        
                        <!-- Loading indicator -->
                        <ProgressBar
                            android:id="@+id/video_loading_indicator"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:visibility="gone"
                            android:indeterminateTint="?attr/colorPrimary" />
                        
                        <!-- Play Button Overlay (for manual play) -->
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/video_play_button"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_play_circle"
                            android:contentDescription="Play video"
                            android:background="@drawable/bg_play_button"
                            android:elevation="4dp"
                            android:visibility="visible"
                            app:tint="@color/white" />
                        
                        <!-- Mute/Unmute Button -->
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/video_mute_button"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="12dp"
                            android:src="@drawable/ic_volume_off"
                            android:contentDescription="Toggle mute"
                            android:background="@drawable/bg_mute_button"
                            android:padding="6dp"
                            android:visibility="gone"
                            app:tint="@color/white" />
                    </FrameLayout>
                    
                    <!-- Video Info -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:gravity="center_vertical">
                        
                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_video_template"
                            android:layout_marginEnd="8dp"
                            app:tint="?attr/colorPrimary" />
                        
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/video_duration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.EventWish.Caption"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            tools:text="0:30" />
                        
                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />
                        
                        <com.google.android.material.chip.Chip
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HD Video"
                            android:textSize="11sp"
                            style="@style/Widget.EventWish.Chip" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Template Type Badge -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/template_type_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_type_badge"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:elevation="2dp"
                    android:visibility="gone"
                    tools:text="HTML"
                    tools:visibility="visible" />

                <!-- Badges at top-right -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:orientation="vertical"
                    android:layout_margin="12dp">
                    
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/newBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NEW"
                        android:textColor="?attr/colorOnSecondary"
                        android:background="?attr/colorSecondary"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:visibility="visible" />
                        
                    <LinearLayout
                        android:id="@+id/recommendedBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_recommended_badge"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:visibility="gone"
                        tools:visibility="visible">
                        
                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_star"
                            android:contentDescription="Recommended star icon"
                            android:layout_marginEnd="3dp" />
                            
                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RECOMMENDED"
                            android:textColor="?attr/colorOnPrimary"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- Instagram-style Action Bar with Grouped Elements -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="8dp"
                android:baselineAligned="false"
                android:gravity="center_vertical">

                <!-- Like Group -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:minHeight="40dp">
                    
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/likeIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_heart_outline"
                        android:contentDescription="Like template"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="2dp" />
                        
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/likeCountText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginTop="2dp"
                        tools:text="12" />
                </LinearLayout>
                
                <!-- Share Group -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="24dp"
                    android:gravity="center_horizontal"
                    android:minHeight="40dp">
                    
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/shareIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_share_outline"
                        android:contentDescription="Share template"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="2dp" />
                        
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/shareCountText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginTop="2dp"
                        tools:text="5" />
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Favorite Group -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:minHeight="40dp">
                    
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/favoriteIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_bookmark_outline"
                        android:contentDescription="Save to favorites"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="2dp" />
                        
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/favoriteCountText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginTop="2dp"
                        tools:text="8" />

                    <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/fallbackTimeText"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
