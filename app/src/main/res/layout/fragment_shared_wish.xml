<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/rootLayout"
    android:fitsSystemWindows="false"
    tools:context=".ui.wish.SharedWishFragment">

    <!-- Main Content Layout with Edge-to-Edge Support -->
    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="false">

        <!-- Status Bar Spacer for Dynamic Height -->
        <View
            android:id="@+id/statusBarSpacer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fitsSystemWindows="true"
            android:visibility="gone" />

        <!-- Top Controls with Glassmorphism -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="48dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:gravity="center_vertical">

            <!-- Back Button with Enhanced Styling -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/backButton"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="16dp"
                app:icon="@drawable/ic_arrow_back"
                app:iconSize="24dp"
                app:iconGravity="textStart"
                app:backgroundTint="@color/md_theme_light_surfaceContainer"
                app:iconTint="@color/md_theme_light_onSurface"
                app:cornerRadius="24dp"
                app:strokeWidth="0dp"
                android:elevation="8dp"
                android:translationZ="4dp" />

            <!-- Title Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Analytics Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/analyticsButton"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                app:icon="@drawable/ic_analytics"
                app:iconSize="20dp"
                app:backgroundTint="@color/md_theme_light_surfaceContainer"
                app:iconTint="@color/md_theme_light_onSurfaceVariant"
                app:cornerRadius="24dp"
                android:elevation="4dp" />

            <!-- Reuse Template Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/reuseTemplateButton"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:icon="@drawable/ic_refresh"
                app:iconSize="20dp"
                app:backgroundTint="@color/md_theme_light_surfaceContainer"
                app:iconTint="@color/md_theme_light_onSurfaceVariant"
                app:cornerRadius="24dp"
                android:elevation="4dp" />

        </LinearLayout>

        <!-- WebView Container with Enhanced Styling -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:layout_marginBottom="8dp">

            <!-- WebView for Content -->
            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:nestedScrollingEnabled="false" />

            <!-- Loading Indicator -->
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/loadingIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true"
                app:indicatorColor="@color/md_theme_light_primary"
                app:trackColor="@color/md_theme_light_surfaceVariant"
                android:visibility="visible" />

            <!-- Progress Bar (Linear version for Java code compatibility) -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:indeterminate="true"
                app:indicatorColor="@color/md_theme_light_primary"
                app:trackColor="@color/md_theme_light_surfaceVariant"
                android:visibility="gone" />

            <!-- Loading View (Full overlay for Java code compatibility) -->
            <LinearLayout
                android:id="@+id/loadingView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@color/md_theme_light_surface"
                android:visibility="gone">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    app:indicatorColor="@color/md_theme_light_primary"
                    app:trackColor="@color/md_theme_light_surfaceVariant" />

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/loading"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/md_theme_light_onSurface" />

            </LinearLayout>

        </FrameLayout>

        <!-- Bottom Controls with Enhanced Styling -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="32dp">

            <!-- Watch Ad Card with Glassmorphism -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/watchAdCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/md_theme_light_surfaceContainer"
                app:cardCornerRadius="16dp"
                app:cardElevation="12dp"
                app:strokeColor="@color/md_theme_light_outline"
                app:strokeWidth="1dp"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <!-- Watch Ad Icon -->
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="12dp"
                        android:src="@drawable/ic_play_circle_filled"
                        app:tint="@color/md_theme_light_primary" />

                    <!-- Watch Ad Text -->
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/watchAdButtonText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/watch_ad_to_share"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="@color/md_theme_light_onSurface" />

                    <!-- Countdown Timer -->
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/countdownTimerView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_timer_chip"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="02:00"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?attr/colorOnPrimary"
                        android:elevation="6dp"
                        android:visibility="gone" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Watch Ad Button (Clickable version for Java code compatibility) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/watchAdButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:text="@string/watch_ad_to_share"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                app:backgroundTint="@color/md_theme_light_secondary"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_play_circle_filled"
                app:iconGravity="textStart"
                app:iconSize="20dp"
                android:elevation="4dp"
                android:visibility="gone" />

            <!-- Share Button Container -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Share Button with Enhanced Styling -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/shareButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/share_wish"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    app:backgroundTint="@color/md_theme_light_primary"
                    app:cornerRadius="28dp"
                    app:icon="@drawable/ic_share"
                    app:iconGravity="textStart"
                    app:iconSize="20dp"
                    android:elevation="8dp"
                    android:translationZ="4dp"
                    android:visibility="gone" />

                <!-- Share Lock Icon (overlay on share button) -->
                <ImageView
                    android:id="@+id/shareLockIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="16dp"
                    android:src="@drawable/ic_lock"
                    app:tint="?attr/colorOnPrimary"
                    android:visibility="gone" />

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Error Message -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/errorMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/error_loading_wish"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="@color/md_theme_light_error"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
