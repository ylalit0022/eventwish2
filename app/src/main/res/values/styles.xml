    <!-- Add missing Body style -->
    <style name="TextAppearance.EventWish.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
