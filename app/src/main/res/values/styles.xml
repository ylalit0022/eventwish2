    <!-- ========== FESTIVE GREETING CARD STYLES ========== -->
    
    <!-- Celebratory Card Style for Greeting Card Previews -->
    <style name="Widget.EventWish.Card.Festive" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/card_festive_light</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">1dp</item>
        <item name="contentPadding">0dp</item>
        <item name="rippleColor">@android:color/transparent</item>
        <item name="strokeColor">@color/md_theme_light_outlineVariant</item>
        <item name="strokeWidth">0.5dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.EventWish.Card</item>
        <item name="android:background">@drawable/bg_card_festive</item>
    </style>

    <!-- Theme overlay for cards to ensure proper Material 3 styling -->
    <style name="ThemeOverlay.EventWish.Card" parent="">
        <item name="colorSurface">@color/card_festive_light</item>
    </style>

