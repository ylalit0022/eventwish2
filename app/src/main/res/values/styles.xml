        <item name="fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.EventWish.Headline3" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.EventWish.Headline4" parent="TextAppearance.Material3.TitleLarge">
