<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.EventWish" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand colors -->
        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="colorOnPrimary">@color/md_theme_light_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_light_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_light_onPrimaryContainer</item>
        
        <!-- Secondary brand colors -->
        <item name="colorSecondary">@color/md_theme_light_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_light_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_light_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_light_onSecondaryContainer</item>
        
        <!-- Tertiary colors -->
        <item name="colorTertiary">@color/md_theme_light_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_light_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_light_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_light_onTertiaryContainer</item>
        
        <!-- Surface colors -->
        <item name="colorSurface">@color/md_theme_light_surface</item>
        <item name="colorOnSurface">@color/md_theme_light_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_light_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_light_onSurfaceVariant</item>
        <item name="colorSurfaceContainer">@color/md_theme_light_surfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/md_theme_light_surfaceContainerHigh</item>
        <item name="colorSurfaceContainerLow">@color/md_theme_light_surfaceContainerLow</item>
        <item name="colorSurfaceContainerLowest">@color/md_theme_light_surfaceContainerLowest</item>
        
        <!-- Background colors -->
        <item name="android:colorBackground">@color/md_theme_light_background</item>
        <item name="colorOnBackground">@color/md_theme_light_onBackground</item>
        
        <!-- Error colors -->
        <item name="colorError">@color/md_theme_light_error</item>
        <item name="colorOnError">@color/md_theme_light_onError</item>
        <item name="colorErrorContainer">@color/md_theme_light_errorContainer</item>
        <item name="colorOnErrorContainer">@color/md_theme_light_onErrorContainer</item>
        
        <!-- Outline colors -->
        <item name="colorOutline">@color/md_theme_light_outline</item>
        <item name="colorOutlineVariant">@color/md_theme_light_outlineVariant</item>
        
        <!-- Status bar -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar">true</item>
        
        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/md_theme_light_onSurface</item>
        <item name="android:textColorSecondary">@color/md_theme_light_onSurfaceVariant</item>
        
        <!-- Text appearances -->
        <item name="textAppearanceHeadline1">@style/TextAppearance.EventWish.Headline1</item>
        <item name="textAppearanceHeadline2">@style/TextAppearance.EventWish.Headline2</item>
        <item name="textAppearanceHeadline3">@style/TextAppearance.EventWish.Headline3</item>
        <item name="textAppearanceHeadline4">@style/TextAppearance.EventWish.Headline4</item>
        <item name="textAppearanceHeadline5">@style/TextAppearance.EventWish.Headline5</item>
        <item name="textAppearanceHeadline6">@style/TextAppearance.EventWish.Headline6</item>
        <item name="textAppearanceSubtitle1">@style/TextAppearance.EventWish.Subtitle1</item>
        <item name="textAppearanceSubtitle2">@style/TextAppearance.EventWish.Subtitle2</item>
        <item name="textAppearanceBody1">@style/TextAppearance.EventWish.Body1</item>
        <item name="textAppearanceBody2">@style/TextAppearance.EventWish.Body2</item>
        <item name="textAppearanceCaption">@style/TextAppearance.EventWish.Caption</item>
        <item name="textAppearanceButton">@style/TextAppearance.EventWish.Button</item>
        <item name="textAppearanceOverline">@style/TextAppearance.EventWish.Overline</item>
        
        <!-- Component styles -->
        <item name="materialCardViewStyle">@style/Widget.EventWish.Card</item>
        <item name="chipStyle">@style/Widget.EventWish.Chip</item>
        <item name="textInputStyle">@style/Widget.EventWish.TextInputLayout</item>
    </style>

    <style name="Theme.EventWish.Splash" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/splash_background</item>
        <item name="android:navigationBarColor">@color/splash_background</item>
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>