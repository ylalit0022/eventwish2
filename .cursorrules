### 3. Update styles.xml
```xml
<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- CardView Style -->
    <style name="Widget.EventWish.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">2dp</item>
        <item name="contentPadding">16dp</item>
        <item name="rippleColor">@color/ripple</item>
        <item name="cardForegroundColor">@null</item>
        <item name="strokeColor">@color/card_stroke</item>
    </style>

    <!-- Chip Style -->
    <style name="Widget.EventWish.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- TextInputLayout Style -->
    <style name="Widget.EventWish.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">?attr/colorPrimary</item>
        <item name="hintTextColor">?attr/colorPrimary</item>
        <item name="boxStrokeWidth">2dp</item>
        <item name="hintAnimationEnabled">true</item>
        <item name="errorEnabled">true</item>
        <item name="errorTextColor">?attr/colorError</item>
    </style>

    <!-- Button Style -->
    <style name="Widget.EventWish.Button" parent="Widget.Material3.Button">
        <item name="android:padding">16dp</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
    </style>

    <!-- Dialog Theme -->
    <style name="DialogTheme" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:textColorSecondary">?attr/colorOnSurfaceVariant</item>
        <item name="colorPrimary">?attr/colorPrimary</item>
    </style>

    <!-- Bottom Sheet Dialog Theme -->
    <style name="BottomSheetDialogTheme" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetStyle</item>
    </style>

    <style name="BottomSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- Keep other styles with updated parent references -->
</resources>
```

